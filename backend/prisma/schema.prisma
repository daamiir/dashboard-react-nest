generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  SMARTPHONE
  LAPTOP
  TABLET
  HEADPHONES
}

model Product {
  id            String   @id @default(uuid())
  name          String
  category      Category @default(SMARTPHONE)
  brand         String
  price         Float
  stockQuantity Int      @default(0)
  images        String[]
  description   String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- Fixed: most-common filters ---
  ram           Int
  storage       Int
  screenSize    Float
  processor     String
  color         String
  os            String
  releaseYear   Int
  has5G         Boolean  @default(false)
  hasNfc        Boolean  @default(false)

  // --- Flexible: rare filters ---
  attributes    Json?

  sellerId      String
  seller        User @relation(fields: [sellerId], references: [id])

  @@index([category])
  @@index([brand])
  @@index([ram])
  @@index([storage])
  @@index([price])
  @@index([os])
  @@index([has5G])
  @@index([sellerId])
}

enum Role {
  BUYER
  SELLER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products  Product[]
}