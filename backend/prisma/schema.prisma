generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [btree_gin]
}

enum Category {
  SMARTPHONE
  LAPTOP
  TABLET
  HEADPHONES
}

model Product {
  id            String   @id @default(uuid())
  name          String
  brand         String
  category      Category @default(SMARTPHONE)
  price         Float
  stockQuantity Int      @default(0)
  images        String[]
  description   String   @db.Text

  attributes    Json

  sellerId      String
  seller        User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@index([category])
  @@index([brand])
  @@index([price])
  @@index([sellerId])
}

enum Role {
  BUYER
  SELLER
}

model User {
  id           String   @id @default(uuid())
  name         String
  passwordHash String
  email        String   @unique
  role         Role     @default(BUYER)
  products  Product[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}